{
  "name": "oidc-test-issuer",
  "version": "1.0.0",
  "description": "Stateless OpenID Connect issuer for tests, served by a web-standard fetch handler",
  "homepage": "https://github.com/IlyaSemenov/oidc-test-issuer#readme",
  "bugs": "https://github.com/IlyaSemenov/oidc-test-issuer/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/oidc-test-issuer.git"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build",
    "release": "changesets-local",
    "test": "bun test",
    "types": "bun check && bun check -p tests"
  },
  "dependencies": {
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@ilyasemenov/oxc-config": "^0.1.3",
    "@tsconfig/bun": "^1.0.12",
    "@types/bun": "^1.4.4",
    "changesets-local": "^1.6.0",
    "openid-client": "^6.9.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
